# ========================================================================
# Voltwise — environment variables
# Copy to `.env.local` and fill in. Never commit `.env.local`.
# ========================================================================

# --- Supabase (DB + Auth + Storage) ----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                        # public anon key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                            # server-only, bypasses RLS

# Direct Postgres connection (for Drizzle migrations / server queries)
# Get from Supabase: Project Settings → Database → Connection string → URI (use the `pooler` for serverless)
DATABASE_URL=postgres://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Inngest (background jobs / cron) --------------------------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Manual ingest endpoint --------------------------------------------------
# Long random string. Required by POST /api/ingest/omie via Authorization: Bearer.
# Generate: openssl rand -hex 32
INGEST_SECRET=

# --- AI (invoice auditor) --------------------------------------------------
# Google Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override; defaults to gemini-2.5-flash (fast + cheap, supports PDF input).
# Use gemini-2.5-pro for tougher invoices.
GEMINI_MODEL=gemini-2.5-flash

# --- External data sources -------------------------------------------------
# ESIOS personal token (free, request at consultasios@ree.es)
ESIOS_TOKEN=
# ENTSO-E Transparency Platform security token
ENTSOE_TOKEN=
# Datadis credentials (Spanish consumption hub) — optional for MVP
DATADIS_USER=
DATADIS_PASSWORD=

# --- Smart Guard notifications -------------------------------------------
# Web Push VAPID — required for browser push.
# Generate once: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@voltwise.app

# WhatsApp Cloud API (optional — leave empty to use the dev stub that just logs)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
